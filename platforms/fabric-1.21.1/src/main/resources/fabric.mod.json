{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthors}"
  ],
  "license": "${modLicense}",
  "icon": "assets/emotify/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.whish.emotify.fabric.EmotifyFabric"
    ],
    "client": [
      "me.whish.emotify.fabric.client.EmotifyFabricClient"
    ],
    "modmenu": [
      "me.whish.emotify.fabric.client.EmotifyModMenu"
    ]
  },
  "mixins": [
    "emotify.mixins.json",
    {
      "config": "emotify.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": ">=${fabricApiVersion}",
    "fabric-language-kotlin": ">=${fabricLanguageKotlinVersion}",
    "minecraft": "=${minecraftVersion}",
    "java": ">=21"
  }
}
